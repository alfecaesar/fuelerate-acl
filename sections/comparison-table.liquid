          "label": "Icon"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Name",
          "default": "Terra Therapy"
        },
        {
          "type": "textarea",
          "id": "how_it_works",
          "label": "How it works",
          "default": "Reconnects body to Earth's natural charge to reduce inflammation and improve sleep"
        },
        {
          "type": "textarea",
          "id": "what_to_consider",
          "label": "What to consider",
          "default": "Requires grounded outlet and direct skin contact for best results"
        },
        {
          "type": "text",
          "id": "cost_over_time",
          "label": "Cost over time",
          "default": "One-time purchase"
        },
        {
          "type": "text",
          "id": "side_effects",
          "label": "Side effects",
          "default": "None - 100% safe, drug-free"
        }
      ]
    },
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sleeping Pills"
        },
        {
          "type": "textarea",
          "id": "how_it_works",
          "label": "How it works",
          "default": "Sedate the brain with sleep-inducing chemicals"
        },
        {
          "type": "textarea",
          "id": "what_to_consider",
          "label": "What to consider",
