{%- assign featured_product = section.settings.featured_product -%}
{%- assign featured_variant_id = blank -%}
{%- if featured_product -%}
  {%- assign featured_variant_id = featured_product.selected_or_first_available_variant.id -%}
{%- endif -%}

{%- assign attribute_labels = "How it works,What to consider,Cost over time,Side effects" | split: "," -%}
{%- assign attribute_keys = "how_it_works,what_to_consider,cost_over_time,side_effects" | split: "," -%}

<div
  id="comparison-table-{{ section.id }}"
  class="comparison-table-wrapper tw-bg-cream tw-py-14 md:tw-py-20"
  data-comparison-table
  data-section-id="{{ section.id }}"
>
  <div class="tw-max-w-[1440px] tw-mx-auto tw-px-4 sm:tw-px-6">

    {%- if section.settings.heading != blank -%}
      <h2 class="tw-text-[24px] md:tw-text-[64px] tw-leading-[120%] font-heading-family tw-text-center tw-mt-0 md:tw-mt-[20px] tw-mb-5 md:tw-mb-0">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%} ============ DESKTOP TABLE (md and up) ============ {%- endcomment -%}
    <div class="tw-hidden md:tw-block">
      <div class="tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden">
        <table class="tw-w-full tw-border-collapse">
          <thead>
            <tr>
              <th class="tw-text-center tw-text-[16px] tw-leading-[111%] tw-font-bold tw-py-[20px] tw-px-6 tw-w-[16%]">Solution</th>
              <th class="tw-text-center tw-text-[16px] tw-leading-[111%] tw-font-bold tw-py-[20px] tw-px-6 tw-w-[30%]">How it works</th>
              <th class="tw-text-center tw-text-[16px] tw-leading-[111%] tw-font-bold tw-py-[20px] tw-px-6 tw-w-[22%]">What to consider</th>
              <th class="tw-text-center tw-text-[16px] tw-leading-[111%] tw-font-bold tw-py-[20px] tw-px-6 tw-w-[13%]">Cost over time</th>
              <th class="tw-text-center tw-text-[16px] tw-leading-[111%] tw-font-bold tw-py-[20px] tw-px-6 tw-w-[19%]">Side effects</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'featured_row' -%}
                <tr {{ block.shopify_attributes }} class="bg-gradient">
                  <td class="tw-py-6 tw-px-6 tw-align-middle">
                    <div class="tw-flex tw-flex-col tw-items-center tw-gap-2">
                      {%- if block.settings.icon -%}
                        <img
                          src="{{ block.settings.icon | image_url: width: 70 }}"
                          alt="{{ block.settings.icon.alt | default: block.settings.logo_text }}"
                          width="70"
                          height="70"
                          loading="lazy"
                          class="tw-w-[70px] tw-h-[70px] tw-object-contain"
                        >
                      {%- endif -%}
                      <span class="tw-text-white tw-text-[16px] tw-leading-[111%] tw-font-bold">
                        {{ block.settings.logo_text }}
                      </span>
                    </div>
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-text-[16px] tw-leading-[111%] tw-font-bold">
                    {{ block.settings.how_it_works }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-text-[16px] tw-leading-[111%] tw-font-bold">
                    {{ block.settings.what_to_consider }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-text-[16px] tw-leading-[111%] tw-font-bold">
                    {{ block.settings.cost_over_time }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-text-[16px] tw-leading-[111%] tw-font-bold">
                    {{ block.settings.side_effects }}
                  </td>
                </tr>
              {%- else -%}
                <tr {{ block.shopify_attributes }} class="tw-border-t tw-border-olive-100">
                  <td class="tw-py-5 tw-px-6 tw-align-middle">
                    <div class="tw-flex tw-flex-col tw-items-center tw-gap-2">
                      {%- if block.settings.icon -%}
                        <img
                          src="{{ block.settings.icon | image_url: width: 70 }}"
                          alt="{{ block.settings.icon.alt | default: block.settings.name }}"
                          width="70"
                          height="70"
                          loading="lazy"
                          class="tw-w-[40px] tw-h-[30px] tw-object-contain"
                        >
                      {%- endif -%}
                      <span class="tw-text-[16px] tw-leading-[111%] tw-font-bold tw-text-[#31331E]">{{ block.settings.name }}</span>
                    </div>
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-[16px] tw-leading-[111%] tw-font-normal tw-text-[#31331E]">
                    {{ block.settings.how_it_works }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-[16px] tw-leading-[111%] tw-font-normal tw-text-[#31331E]">
                    {{ block.settings.what_to_consider }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-[16px] tw-leading-[111%] tw-font-normal tw-text-[#31331E]">
                    {{ block.settings.cost_over_time }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-[16px] tw-leading-[111%] tw-font-normal tw-text-[#31331E]">
                    {{ block.settings.side_effects }}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div class="tw-flex tw-justify-center tw-mt-10">
        <button
          type="button"
          data-comparison-add-to-cart
          data-variant-id="{{ featured_variant_id }}"
          {% if featured_variant_id == blank %}disabled{% endif %}
          class="tw-bg-[#A8CA1B] tw-rounded-[50px] tw-border-0 tw-transition-colors tw-duration-200 disabled:tw-opacity-50 disabled:tw-cursor-not-allowed tw-py-[20px] tw-px-[100px] tw-text-[24px] font-heading-family tw-text-[#31331E] tw-leading-[111%] tw-uppercase tw-cursor-pointer"
        >
          <span data-btn-label>{{ section.settings.add_to_cart_label | default: 'Add to Cart' }}</span>
        </button>
      </div>
    </div>

    {%- comment -%} ============ MOBILE LAYOUT (below md) ============ {%- endcomment -%}
    <div class="tw-block md:tw-hidden">
      <div class="tw-flex tw-gap-3 tw-items-stretch">


        <div
          class="tw-w-[104px] tw-flex-shrink-0 tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden tw-self-start"
          data-solution-list
        >
            <div class="tw-text-center tw-text-[11px] tw-pt-[10px] tw-pb-[5px]">Solution</div>
          {%- for block in section.blocks -%}
            {%- assign is_first = forloop.first -%}
            <button
              type="button"
              data-solution-trigger
              data-solution-index="{{ forloop.index0 }}"
              class="tw-border-none tw-w-full tw-flex tw-flex-col tw-items-center tw-gap-1.5 tw-py-3.5 tw-px-2 tw-text-center tw-transition-colors tw-duration-150 tw-bg-white"
              {% if is_first %}style="background: url(https://cdn.shopify.com/s/files/1/1075/1243/0926/files/Rectangle_40142.png?v=1788694884) no-repeat center center / cover;"{% endif %}
            >
              {%- if block.settings.icon -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 60 }}"
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  class="tw-w-6 tw-h-6 tw-object-contain {% if is_first %}tw-brightness-0 tw-invert tw-opacity-90{% endif %}"
                  data-solution-icon
                >
              {%- endif -%}
              <span
                class="tw-text-[11px] tw-leading-tight tw-font-medium {% if is_first %}tw-text-white{% else %}tw-text-olive-900{% endif %}"
                data-solution-label
              >
                {{ block.settings.name | default: block.settings.logo_text }}
              </span>
            </button>
          {%- endfor -%}
        </div>

        {%- comment -%} Sliding attribute panel {%- endcomment -%}
        <div class="tw-flex-1 tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden" data-attribute-viewport>
          <div class="tw-flex tw-overflow-x-auto tw-snap-x tw-snap-mandatory comparison-no-scrollbar" data-attribute-track>
            {%- for label in attribute_labels -%}
              {%- assign attr_key = attribute_keys[forloop.index0] -%}
              <div class="tw-w-full tw-flex-shrink-0 tw-snap-start" data-attribute-page="{{ forloop.index0 }}">
                <div class="tw-py-3.5 tw-px-4 tw-border-b tw-border-olive-100 tw-text-center tw-text-[11px]">
                  {{ label }}
                </div>
                {%- for block in section.blocks -%}
                  {%- assign row_value = block.settings[attr_key] -%}
                  <div
                    data-solution-answer
                    data-solution-index="{{ forloop.index0 }}"
                    class="tw-mx-2 tw-my-1.5 tw-px-3 tw-py-3 tw-rounded-lg tw-text-[11px] {% if forloop.first %} tw-text-white{% else %} tw-text-[#31331E{% endif %}"
                    {% if forloop.first %}style="background: url(https://cdn.shopify.com/s/files/1/1075/1243/0926/files/Rectangle_40142.png?v=1788694884) no-repeat right center / cover;"{% endif %}
                  >
                    {{ row_value }}
                  </div>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- comment -%} Dots {%- endcomment -%}
      <div class="tw-flex tw-justify-center tw-items-center tw-gap-2 tw-mt-4" data-dots>
        {%- for label in attribute_labels -%}
          <button
            type="button"
            aria-label="Show {{ label }}"
            data-dot-index="{{ forloop.index0 }}"
            class="tw-border-none tw-w-2 tw-h-2 tw-rounded-full tw-transition-colors tw-duration-150 {% if forloop.first %}tw-bg-olive-400{% else %}tw-bg-neutral-300{% endif %}"
          ></button>
        {%- endfor -%}
      </div>

      <div class="tw-flex tw-justify-center tw-mt-8">
        <button
          type="button"
          data-comparison-add-to-cart
          data-variant-id="{{ featured_variant_id }}"
          {% if featured_variant_id == blank %}disabled{% endif %}
          class="tw-bg-[#A8CA1B] tw-rounded-[50px] tw-border-0 tw-transition-colors tw-duration-200 disabled:tw-opacity-50 disabled:tw-cursor-not-allowed tw-py-[20px] tw-px-[10px] tw-text-[20px] font-heading-family tw-text-[#31331E] tw-leading-[111%] tw-uppercase tw-cursor-pointer tw-w-full"
        >
          <span data-btn-label>{{ section.settings.add_to_cart_label | default: 'Add to Cart' }}</span>
        </button>
      </div>
    </div>

  </div>
</div>

{%- style -%}
  #comparison-table-{{ section.id }} {
    background-color: #F4F3EE;
  }
  #comparison-table-{{ section.id }} .comparison-no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #comparison-table-{{ section.id }} .comparison-no-scrollbar::-webkit-scrollbar {
    display: none;
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('comparison-table-{{ section.id }}');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    /* ---------- Mobile: solution picker <-> attribute answers ---------- */
    var triggers = root.querySelectorAll('[data-solution-trigger]');
    var answers = root.querySelectorAll('[data-solution-answer]');

    function selectSolution(index) {
      triggers.forEach(function (btn) {
        var active = btn.getAttribute('data-solution-index') === String(index);
        var icon = btn.querySelector('[data-solution-icon]');
        var label = btn.querySelector('[data-solution-label]');
        btn.classList.toggle('tw-bg-olive-500', active);
        btn.classList.toggle('tw-bg-white', !active);
        if (icon) icon.classList.toggle('tw-brightness-0', active);
        if (icon) icon.classList.toggle('tw-invert', active);
        if (icon) icon.classList.toggle('tw-opacity-90', active);
        if (label) label.classList.toggle('tw-text-white', active);
        if (label) label.classList.toggle('tw-text-olive-900', !active);
      });

      answers.forEach(function (row) {
        var active = row.getAttribute('data-solution-index') === String(index);
        row.classList.toggle('tw-bg-olive-500', active);
        row.classList.toggle('tw-text-white', active);
        row.classList.toggle('tw-font-semibold', active);
        row.classList.toggle('tw-text-neutral-700', !active);
      });
    }

    triggers.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectSolution(btn.getAttribute('data-solution-index'));
      });
    });

    /* ---------- Mobile: swipeable attribute columns + dot nav ---------- */
    var track = root.querySelector('[data-attribute-track]');
    var pages = root.querySelectorAll('[data-attribute-page]');
    var dots = root.querySelectorAll('[data-dot-index]');

    function setActiveDot(index) {
      dots.forEach(function (dot) {
        var active = dot.getAttribute('data-dot-index') === String(index);
        dot.classList.toggle('tw-bg-olive-400', active);
        dot.classList.toggle('tw-bg-neutral-300', !active);
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
        var page = pages[idx];
        if (track && page) {
          track.scrollTo({ left: page.offsetLeft, behavior: 'smooth' });
        }
      });
    });

    if (track && pages.length) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              setActiveDot(entry.target.getAttribute('data-attribute-page'));
            }
          });
        },
        { root: track, threshold: 0.6 }
      );
      pages.forEach(function (page) { observer.observe(page); });
    }

    /* ---------- Add to cart - Dawn compatible ---------- */
var addButtons = root.querySelectorAll('[data-comparison-add-to-cart]');

function addToCart(button) {
  var variantId = button.getAttribute('data-variant-id');
  if (!variantId) return;

  var labelEl = button.querySelector('[data-btn-label]');
  var originalLabel = labelEl ? labelEl.textContent : '';

  button.disabled = true;

  if (labelEl) {
    labelEl.textContent = 'Adding...';
  }

  var cartDrawer = document.querySelector('cart-drawer');

  // Get Dawn's required section IDs
  var sections = [];

  if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
    sections = cartDrawer
      .getSectionsToRender()
      .map(function (section) {
        return section.id;
      });
  }

  fetch(window.Shopify.routes.root + 'cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({
      items: [
        {
          id: Number(variantId),
          quantity: 1
        }
      ],
      sections: sections,
      sections_url: window.location.pathname
    })
  })
    .then(function (response) {
      if (!response.ok) {
        return response.json().then(function (error) {
          throw new Error(
            error.description || 'Could not add item to cart'
          );
        });
      }

      return response.json();
    })
    .then(function (data) {
      console.log('Cart add response:', data);

      if (!cartDrawer) {
        console.warn('Dawn cart-drawer element not found.');
        return;
      }

      if (typeof cartDrawer.renderContents === 'function') {
        cartDrawer.renderContents(data);
      }

      if (typeof cartDrawer.open === 'function') {
        cartDrawer.open(button);
      }
    })
    .catch(function (error) {
      console.error(
        '[Comparison Table] Add to cart failed:',
        error
      );
    })
    .finally(function () {
      button.disabled = false;

      if (labelEl) {
        labelEl.textContent = originalLabel;
      }
    });
}

addButtons.forEach(function (button) {
  button.addEventListener('click', function () {
    addToCart(button);
  });
});
  })();
</script>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Are Really Different"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Product to add to cart",
      "info": "Used by both Add to Cart buttons. Uses the first available variant."
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "featured_row",
      "name": "Featured solution",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Name",
          "default": "Terra Therapy"
        },
        {
          "type": "textarea",
          "id": "how_it_works",
          "label": "How it works",
          "default": "Reconnects body to Earth's natural charge to reduce inflammation and improve sleep"
        },
        {
          "type": "textarea",
          "id": "what_to_consider",
          "label": "What to consider",
          "default": "Requires grounded outlet and direct skin contact for best results"
        },
        {
          "type": "text",
          "id": "cost_over_time",
          "label": "Cost over time",
          "default": "One-time purchase"
        },
        {
          "type": "text",
          "id": "side_effects",
          "label": "Side effects",
          "default": "None - 100% safe, drug-free"
        }
      ]
    },
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sleeping Pills"
        },
        {
          "type": "textarea",
          "id": "how_it_works",
          "label": "How it works",
          "default": "Sedate the brain with sleep-inducing chemicals"
        },
        {
          "type": "textarea",
          "id": "what_to_consider",
          "label": "What to consider",
          "default": "Tolerance builds, grogginess, not long-term safe"
        },
        {
          "type": "text",
          "id": "cost_over_time",
          "label": "Cost over time",
          "default": "Ongoing"
        },
        {
          "type": "text",
          "id": "side_effects",
          "label": "Side effects",
          "default": "Dependency & side effects"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "featured_row" },
        {
          "type": "row",
          "settings": {
            "name": "Sleeping Pills",
            "how_it_works": "Sedate the brain with sleep-inducing chemicals",
            "what_to_consider": "Tolerance builds, grogginess, not long-term safe",
            "cost_over_time": "Ongoing",
            "side_effects": "Dependency & side effects"
          }
        },
        {
          "type": "row",
          "settings": {
            "name": "Pain Meds",
            "how_it_works": "Block pain signals temporarily",
            "what_to_consider": "Doesn't treat root cause, side effects common",
            "cost_over_time": "High if chronic",
            "side_effects": "Risk of addiction or long-term damage"
          }
        },
        {
          "type": "row",
          "settings": {
            "name": "Chiropractor",
            "how_it_works": "Manual realignment of joints/spine",
            "what_to_consider": "Frequent visits needed, temporary relief",
            "cost_over_time": "High recurring cost",
            "side_effects": "Not suitable for every condition"
