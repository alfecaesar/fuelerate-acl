          "settings": {
            "name": "Supplements",
            "how_it_works": "Target isolated symptoms like melatonin or blue light",
            "what_to_consider": "Vary in effectiveness, often don't address the root",
            "cost_over_time": "Ongoing",
            "side_effects": "Often unproven or inconsistent"
          }
        }
      ]
    }
  ]
}
{% endschema %}
