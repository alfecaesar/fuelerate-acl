{%- assign featured_product = section.settings.featured_product -%}
{%- assign featured_variant_id = blank -%}
{%- if featured_product -%}
  {%- assign featured_variant_id = featured_product.selected_or_first_available_variant.id -%}
{%- endif -%}

{%- assign attribute_labels = "How it works,What to consider,Cost over time,Side effects" | split: "," -%}
{%- assign attribute_keys = "how_it_works,what_to_consider,cost_over_time,side_effects" | split: "," -%}

<div
  id="comparison-table-{{ section.id }}"
  class="comparison-table-wrapper tw-bg-cream tw-py-14 md:tw-py-20"
  data-comparison-table
  data-section-id="{{ section.id }}"
>
  <div class="tw-max-w-6xl tw-mx-auto tw-px-4 sm:tw-px-6">

    {%- if section.settings.heading != blank -%}
      <h2 class="tw-font-serif tw-text-3xl sm:tw-text-4xl md:tw-text-5xl tw-text-center tw-text-olive-900 tw-mb-8 md:tw-mb-12">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%} ============ DESKTOP TABLE (md and up) ============ {%- endcomment -%}
    <div class="tw-hidden md:tw-block">
      <div class="tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden">
        <table class="tw-w-full tw-border-collapse">
          <thead>
            <tr>
              <th class="tw-text-left tw-text-sm tw-font-semibold tw-text-olive-900 tw-py-4 tw-px-6 tw-w-[16%]">Solution</th>
              <th class="tw-text-left tw-text-sm tw-font-semibold tw-text-olive-900 tw-py-4 tw-px-6 tw-w-[26%]">How it works</th>
              <th class="tw-text-left tw-text-sm tw-font-semibold tw-text-olive-900 tw-py-4 tw-px-6 tw-w-[26%]">What to consider</th>
              <th class="tw-text-left tw-text-sm tw-font-semibold tw-text-olive-900 tw-py-4 tw-px-6 tw-w-[16%]">Cost over time</th>
              <th class="tw-text-left tw-text-sm tw-font-semibold tw-text-olive-900 tw-py-4 tw-px-6 tw-w-[16%]">Side effects</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'featured_row' -%}
                <tr {{ block.shopify_attributes }} class="tw-bg-gradient-to-r tw-from-olive-800 tw-to-olive-600">
                  <td class="tw-py-6 tw-px-6 tw-align-middle">
                    <div class="tw-flex tw-flex-col tw-items-start tw-gap-2">
                      {%- if block.settings.icon -%}
                        <img
                          src="{{ block.settings.icon | image_url: width: 80 }}"
                          alt="{{ block.settings.icon.alt | default: block.settings.logo_text }}"
                          width="32"
                          height="32"
                          loading="lazy"
                          class="tw-w-8 tw-h-8 tw-object-contain tw-brightness-0 tw-invert tw-opacity-90"
                        >
                      {%- endif -%}
                      <span class="tw-text-white tw-font-semibold tw-text-sm">{{ block.settings.logo_text }}</span>
                    </div>
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-font-semibold tw-text-sm tw-leading-relaxed">
                    {{ block.settings.how_it_works }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-font-semibold tw-text-sm tw-leading-relaxed">
                    {{ block.settings.what_to_consider }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-font-semibold tw-text-sm">
                    {{ block.settings.cost_over_time }}
                  </td>
                  <td class="tw-py-6 tw-px-6 tw-align-middle tw-text-white tw-font-semibold tw-text-sm">
                    {{ block.settings.side_effects }}
                  </td>
                </tr>
              {%- else -%}
                <tr {{ block.shopify_attributes }} class="tw-border-t tw-border-olive-100">
                  <td class="tw-py-5 tw-px-6 tw-align-middle">
                    <div class="tw-flex tw-flex-col tw-items-start tw-gap-2">
                      {%- if block.settings.icon -%}
                        <img
                          src="{{ block.settings.icon | image_url: width: 80 }}"
                          alt="{{ block.settings.icon.alt | default: block.settings.name }}"
                          width="28"
                          height="28"
                          loading="lazy"
                          class="tw-w-7 tw-h-7 tw-object-contain"
                        >
                      {%- endif -%}
                      <span class="tw-font-semibold tw-text-sm tw-text-olive-900">{{ block.settings.name }}</span>
                    </div>
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-sm tw-text-neutral-700 tw-leading-relaxed">
                    {{ block.settings.how_it_works }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-sm tw-text-neutral-700 tw-leading-relaxed">
                    {{ block.settings.what_to_consider }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-sm tw-text-neutral-700">
                    {{ block.settings.cost_over_time }}
                  </td>
                  <td class="tw-py-5 tw-px-6 tw-align-middle tw-text-sm tw-text-neutral-700">
                    {{ block.settings.side_effects }}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div class="tw-flex tw-justify-center tw-mt-10">
        <button
          type="button"
          data-comparison-add-to-cart
          data-variant-id="{{ featured_variant_id }}"
          {% if featured_variant_id == blank %}disabled{% endif %}
          class="tw-font-serif tw-text-lg tw-text-olive-950 tw-bg-olive-400 hover:tw-bg-olive-500 tw-px-12 tw-py-4 tw-rounded-full tw-transition-colors tw-duration-200 disabled:tw-opacity-50 disabled:tw-cursor-not-allowed"
        >
          <span data-btn-label>{{ section.settings.add_to_cart_label | default: 'Add to Cart' }}</span>
        </button>
      </div>
    </div>

    {%- comment -%} ============ MOBILE LAYOUT (below md) ============ {%- endcomment -%}
    <div class="tw-block md:tw-hidden">
      <div class="tw-flex tw-gap-3 tw-items-stretch">

        {%- comment -%} Solution picker {%- endcomment -%}
        <div
          class="tw-w-[104px] tw-flex-shrink-0 tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden tw-self-start"
          data-solution-list
        >
          {%- for block in section.blocks -%}
            {%- assign is_first = forloop.first -%}
            <button
              type="button"
              data-solution-trigger
              data-solution-index="{{ forloop.index0 }}"
              class="tw-w-full tw-flex tw-flex-col tw-items-center tw-gap-1.5 tw-py-3.5 tw-px-2 tw-text-center tw-transition-colors tw-duration-150 {% unless forloop.last %}tw-border-b tw-border-olive-100{% endunless %} {% if is_first %}tw-bg-olive-500{% else %}tw-bg-white{% endif %}"
            >
              {%- if block.settings.icon -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 60 }}"
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  class="tw-w-6 tw-h-6 tw-object-contain {% if is_first %}tw-brightness-0 tw-invert tw-opacity-90{% endif %}"
                  data-solution-icon
                >
              {%- endif -%}
              <span
                class="tw-text-[11px] tw-leading-tight tw-font-medium {% if is_first %}tw-text-white{% else %}tw-text-olive-900{% endif %}"
                data-solution-label
              >
                {{ block.settings.name | default: block.settings.logo_text }}
              </span>
            </button>
          {%- endfor -%}
        </div>

        {%- comment -%} Sliding attribute panel {%- endcomment -%}
        <div class="tw-flex-1 tw-bg-white tw-rounded-2xl tw-shadow-sm tw-overflow-hidden" data-attribute-viewport>
          <div class="tw-flex tw-overflow-x-auto tw-snap-x tw-snap-mandatory comparison-no-scrollbar" data-attribute-track>
            {%- for label in attribute_labels -%}
              {%- assign attr_key = attribute_keys[forloop.index0] -%}
              <div class="tw-w-full tw-flex-shrink-0 tw-snap-start" data-attribute-page="{{ forloop.index0 }}">
                <div class="tw-py-3.5 tw-px-4 tw-border-b tw-border-olive-100 tw-text-center tw-font-semibold tw-text-sm tw-text-olive-900">
                  {{ label }}
                </div>
                {%- for block in section.blocks -%}
                  {%- assign row_value = block.settings[attr_key] -%}
                  <div
                    data-solution-answer
                    data-solution-index="{{ forloop.index0 }}"
                    class="tw-mx-2 tw-my-1.5 tw-px-3 tw-py-3 tw-rounded-lg tw-text-sm tw-leading-relaxed tw-transition-colors tw-duration-150 {% if forloop.first %}tw-bg-olive-500 tw-text-white tw-font-semibold{% else %}tw-text-neutral-700{% endif %}"
                  >
                    {{ row_value }}
                  </div>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- comment -%} Dots {%- endcomment -%}
      <div class="tw-flex tw-justify-center tw-items-center tw-gap-2 tw-mt-4" data-dots>
        {%- for label in attribute_labels -%}
          <button
            type="button"
            aria-label="Show {{ label }}"
            data-dot-index="{{ forloop.index0 }}"
            class="tw-w-2 tw-h-2 tw-rounded-full tw-transition-colors tw-duration-150 {% if forloop.first %}tw-bg-olive-400{% else %}tw-bg-neutral-300{% endif %}"
          ></button>
        {%- endfor -%}
      </div>

      <div class="tw-flex tw-justify-center tw-mt-8">
        <button
          type="button"
          data-comparison-add-to-cart
          data-variant-id="{{ featured_variant_id }}"
          {% if featured_variant_id == blank %}disabled{% endif %}
          class="tw-w-full tw-font-serif tw-text-base tw-text-olive-950 tw-bg-olive-400 hover:tw-bg-olive-500 tw-px-8 tw-py-4 tw-rounded-full tw-transition-colors tw-duration-200 disabled:tw-opacity-50 disabled:tw-cursor-not-allowed"
        >
          <span data-btn-label>{{ section.settings.add_to_cart_label | default: 'Add to Cart' }}</span>
        </button>
      </div>
    </div>

  </div>
</div>

{%- style -%}
  #comparison-table-{{ section.id }} .comparison-no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #comparison-table-{{ section.id }} .comparison-no-scrollbar::-webkit-scrollbar {
    display: none;
  }
{%- endstyle -%}

{%- comment -%}
  Tailwind is loaded once per page via the Play CDN and prefixed with "tw-" so it can't
  collide with theme styles. The custom palette below is what gives us the olive/cream
  tones from the design without hand-rolling a bunch of one-off hex classes everywhere.
{%- endcomment -%}
<script>
  (function () {
    if (window.__comparisonTableTailwindReady) return;
    window.__comparisonTableTailwindReady = true;

    window.tailwind = window.tailwind || {};
    window.tailwind.config = {
      prefix: 'tw-',
      theme: {
        extend: {
          colors: {
            cream: '#f2efe7',
            olive: {
              50: '#f4f6ec',
              100: '#e6ebd6',
              400: '#a9c93c',
              500: '#95b432',
              600: '#7c9829',
              800: '#3c5530',
              900: '#31432a',
              950: '#26331f'
            }
          },
          fontFamily: {
            serif: ['Georgia', 'Cambria', 'Times New Roman', 'Times', 'serif']
          }
        }
      }
    };

    var tw = document.createElement('script');
    tw.src = 'https://cdn.tailwindcss.com';
    document.head.appendChild(tw);
  })();
</script>

<script>
  (function () {
    var root = document.getElementById('comparison-table-{{ section.id }}');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    /* ---------- Mobile: solution picker <-> attribute answers ---------- */
    var triggers = root.querySelectorAll('[data-solution-trigger]');
    var answers = root.querySelectorAll('[data-solution-answer]');

    function selectSolution(index) {
      triggers.forEach(function (btn) {
        var active = btn.getAttribute('data-solution-index') === String(index);
        var icon = btn.querySelector('[data-solution-icon]');
        var label = btn.querySelector('[data-solution-label]');
        btn.classList.toggle('tw-bg-olive-500', active);
        btn.classList.toggle('tw-bg-white', !active);
        if (icon) icon.classList.toggle('tw-brightness-0', active);
        if (icon) icon.classList.toggle('tw-invert', active);
        if (icon) icon.classList.toggle('tw-opacity-90', active);
        if (label) label.classList.toggle('tw-text-white', active);
        if (label) label.classList.toggle('tw-text-olive-900', !active);
      });

      answers.forEach(function (row) {
        var active = row.getAttribute('data-solution-index') === String(index);
        row.classList.toggle('tw-bg-olive-500', active);
        row.classList.toggle('tw-text-white', active);
        row.classList.toggle('tw-font-semibold', active);
        row.classList.toggle('tw-text-neutral-700', !active);
      });
    }

    triggers.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectSolution(btn.getAttribute('data-solution-index'));
      });
    });

    /* ---------- Mobile: swipeable attribute columns + dot nav ---------- */
    var track = root.querySelector('[data-attribute-track]');
    var pages = root.querySelectorAll('[data-attribute-page]');
    var dots = root.querySelectorAll('[data-dot-index]');

    function setActiveDot(index) {
      dots.forEach(function (dot) {
        var active = dot.getAttribute('data-dot-index') === String(index);
        dot.classList.toggle('tw-bg-olive-400', active);
        dot.classList.toggle('tw-bg-neutral-300', !active);
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
        var page = pages[idx];
        if (track && page) {
          track.scrollTo({ left: page.offsetLeft, behavior: 'smooth' });
        }
      });
    });

    if (track && pages.length) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              setActiveDot(entry.target.getAttribute('data-attribute-page'));
            }
          });
        },
        { root: track, threshold: 0.6 }
      );
      pages.forEach(function (page) { observer.observe(page); });
    }

    /* ---------- Add to cart (Dawn-compatible) ---------- */
    var addButtons = root.querySelectorAll('[data-comparison-add-to-cart]');

    function cartSectionsToFetch() {
      var host = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      if (host && typeof host.getSectionsToRender === 'function') {
        return host.getSectionsToRender().map(function (s) { return s.section; });
      }
      return [];
    }

    function pushIntoDawnCart(data) {
      var notification = document.querySelector('cart-notification');
      var drawer = document.querySelector('cart-drawer');

      if (notification && typeof notification.renderContents === 'function') {
        notification.renderContents(data);
        return;
      }
      if (drawer && typeof drawer.renderContents === 'function') {
        drawer.renderContents(data);
        if (typeof drawer.open === 'function') drawer.open();
        return;
      }
      document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    }

    function addToCart(button) {
      var variantId = button.getAttribute('data-variant-id');
      if (!variantId) return;

      var labelEl = button.querySelector('[data-btn-label]');
      var originalLabel = labelEl ? labelEl.textContent : '';
      button.disabled = true;
      if (labelEl) labelEl.textContent = 'Adding...';

      var cartAddUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add';

      fetch(cartAddUrl + '.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: variantId, quantity: 1 }],
          sections: cartSectionsToFetch(),
          sections_url: window.location.pathname
        })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.status) {
            throw new Error(data.description || 'Could not add item to cart');
          }
          pushIntoDawnCart(data);
        })
        .catch(function (err) {
          console.error('[Comparison Table] add to cart failed:', err);
        })
        .finally(function () {
          button.disabled = false;
          if (labelEl) labelEl.textContent = originalLabel;
        });
    }

    addButtons.forEach(function (btn) {
      btn.addEventListener('click', function () { addToCart(btn); });
    });
  })();
</script>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Are Really Different"
